# Copy to .env and adjust as needed. All values are optional — sane defaults are built in.

PORT=4000

# How often real weather is re-fetched per site from Open-Meteo (cron syntax).
# Default: every 5 minutes. For a live judging demo where you want visible
# weather-driven changes without a long wait, try every 1 minute:
# WEATHER_POLL_CRON="*/1 * * * *"
WEATHER_POLL_CRON="*/1 * * * *"

# How often the simulated live sensor/incident feed ticks, in milliseconds.
# This does NOT call any external API — safe to set low for a lively demo.
# Default: 8000 (8s). Try 3000-4000 for a busier-looking feed during judging.
LIVE_TICK_MS=3000
